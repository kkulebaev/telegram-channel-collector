generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model TelegramPost {
  id              String   @id @default(cuid())

  chatId          String
  messageId       Int

  date            DateTime
  edited          Boolean  @default(false)

  postUrl         String?

  text            String?

  entities        Json?

  raw             Json?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([chatId, messageId])
  @@index([chatId, date])
}
